<clickhouse>
    <!-- Слушать на всех интерфейсах — чтобы к сервису ходили другие контейнеры Compose -->
    <listen_host>0.0.0.0</listen_host>

    <logger>
        <level>warning</level>
    </logger>

    <!--
      Hot/cold: новые parts на локальный диск; старые уходят в MinIO через TTL TO VOLUME.
      Учётные данные из .env (MINIO_ROOT_*). Endpoint // = корень бакета.
    -->
    <storage_configuration>
        <disks>
            <default/>
            <s3_cold>
                <type>s3</type>
                <endpoint>http://minio:9000/ch-cold//</endpoint>
                <access_key_id from_env="MINIO_ROOT_USER"/>
                <secret_access_key from_env="MINIO_ROOT_PASSWORD"/>
                <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
            </s3_cold>
        </disks>
        <policies>
            <tiered>
                <volumes>
                    <hot>
                        <disk>default</disk>
                    </hot>
                    <cold>
                        <disk>s3_cold</disk>
                    </cold>
                </volumes>
            </tiered>
        </policies>
    </storage_configuration>
</clickhouse>
